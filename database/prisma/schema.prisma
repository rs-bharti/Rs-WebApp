generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CountryMaster {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  name      String        @unique
  branches  Branch[]
  customers Customer[]
  states    StateMaster[]
  suppliers Supplier[]
}

model StateMaster {
  id        Int           @id @default(autoincrement())
  countryId Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  name      String
  branches  Branch[]
  cities    CityMaster[]
  customers Customer[]
  country   CountryMaster @relation(fields: [countryId], references: [id])
  suppliers Supplier[]

  @@unique([name, countryId])
}

model CityMaster {
  id         Int               @id @default(autoincrement())
  createdAt  DateTime          @default(now())
  stateId    Int
  updatedAt  DateTime          @updatedAt
  name       String
  areas      AreaMaster[]
  branches   Branch[]
  state      StateMaster       @relation(fields: [stateId], references: [id])
  customers  Customer[]
  suppliers  Supplier[]
  warehouses WarehouseMaster[]

  @@unique([name, stateId])
}

model AreaMaster {
  id         Int               @id @default(autoincrement())
  cityId     Int
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  name       String
  city       CityMaster        @relation(fields: [cityId], references: [id])
  branches   Branch[]
  customers  Customer[]
  suppliers  Supplier[]
  warehouses WarehouseMaster[]

  @@unique([name, cityId])
}

model WarehouseMaster {
  id                Int                    @id @default(autoincrement())
  name              String
  address           String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  areaId            Int?
  cityId            Int?
  branchId          Int?
  stockDataVouchers StockDataVoucher[]
  stockTransferFrom StockTransferVoucher[] @relation("TransferFrom")
  stockTransferTo   StockTransferVoucher[] @relation("TransferTo")
  area              AreaMaster?            @relation(fields: [areaId], references: [id])
  city              CityMaster?            @relation(fields: [cityId], references: [id])
  branch            Branch?                @relation(fields: [branchId], references: [id])
}

model Branch {
  id        Int               @id @default(autoincrement())
  name      String
  address   String?
  areaId    Int?
  cityId    Int
  stateId   Int
  countryId Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  area      AreaMaster?       @relation(fields: [areaId], references: [id])
  city      CityMaster        @relation(fields: [cityId], references: [id])
  country   CountryMaster     @relation(fields: [countryId], references: [id])
  state     StateMaster       @relation(fields: [stateId], references: [id])
  purchases         PurchaseVoucher[]
  sales             SalesVoucher[]
  purchaseReturns   PurchaseReturnVoucher[]
  salesReturns      SalesReturnVoucher[]
  contraVouchers    ContraVoucher[]
  receiptVouchers   ReceiptVoucher[]
  paymentVouchers   PaymentVoucher[]
  stockDataVouchers StockDataVoucher[]
  stockTransfers    StockTransferVoucher[]
  categories        CategoryMaster[]
  suppliers         Supplier[]
  customers         Customer[]
  products          Product[]
  paymentMethods    PaymentMethodMaster[]
  warehouses        WarehouseMaster[]
  users             User[]
}

model CategoryMaster {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  name      String
  branchId  Int?
  branch    Branch?   @relation(fields: [branchId], references: [id])
  products  Product[]

  @@unique([name, branchId])
}

model UnitMaster {
  id        Int       @id @default(autoincrement())
  unitName  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shortName String?
  products  Product[]
}

model Supplier {
  id        Int               @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  email     String?
  gstNo     String?
  areaId    Int?
  cityId    Int
  stateId   Int
  countryId Int
  branchId  Int?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  purchases       PurchaseVoucher[]
  paymentVouchers PaymentVoucher[]
  purchaseReturns PurchaseReturnVoucher[]
  area            AreaMaster?       @relation(fields: [areaId], references: [id])
  city            CityMaster        @relation(fields: [cityId], references: [id])
  country         CountryMaster     @relation(fields: [countryId], references: [id])
  state           StateMaster       @relation(fields: [stateId], references: [id])
  branch          Branch?           @relation(fields: [branchId], references: [id])
}

model Product {
  id                    Int                    @id @default(autoincrement())
  name                  String
  categoryId            Int
  unitId                Int
  purchasePrice         Float
  sellingPrice          Float
  barcode               String?                @unique
  branchId              Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  category              CategoryMaster         @relation(fields: [categoryId], references: [id])
  unit                  UnitMaster             @relation(fields: [unitId], references: [id])
  branch                Branch?                @relation(fields: [branchId], references: [id])
  purchaseItems         PurchaseVoucherItem[]
  salesItems            SalesVoucherItem[]
  stockDataVouchers     StockDataVoucher[]
  stockTransferVouchers StockTransferVoucher[]
  purchaseReturnItems   PurchaseReturnVoucherItem[]
  salesReturnItems      SalesReturnVoucherItem[]
}

model Customer {
  id        Int            @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  gstNo     String?
  areaId    Int?
  cityId    Int
  stateId   Int
  countryId Int
  branchId  Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  area      AreaMaster?    @relation(fields: [areaId], references: [id])
  city      CityMaster     @relation(fields: [cityId], references: [id])
  country   CountryMaster  @relation(fields: [countryId], references: [id])
  state           StateMaster    @relation(fields: [stateId], references: [id])
  branch          Branch?        @relation(fields: [branchId], references: [id])
  sales           SalesVoucher[]
  receiptVouchers ReceiptVoucher[]
  salesReturns    SalesReturnVoucher[]
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
  users       User[]
}

model User {
  id                    Int                    @id @default(autoincrement())
  name                  String
  email                 String                 @unique
  password              String
  plainPassword         String?
  permissions           String                 @default("{}")
  branchId              Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  isActive              Boolean                @default(true)
  roleId                Int
  purchases             PurchaseVoucher[]
  sales                 SalesVoucher[]
  stockDataVouchers     StockDataVoucher[]
  stockTransferVouchers StockTransferVoucher[]
  contraVouchers        ContraVoucher[]
  receiptVouchers       ReceiptVoucher[]
  paymentVouchers       PaymentVoucher[]
  purchaseReturns       PurchaseReturnVoucher[]
  salesReturns          SalesReturnVoucher[]
  branch                Branch                 @relation(fields: [branchId], references: [id])
  role                  Role                   @relation(fields: [roleId], references: [id])
}

model Module {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model Permission {
  id        Int      @id @default(autoincrement())
  roleId    Int
  moduleId  Int
  canCreate Boolean  @default(false)
  canView   Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  module    Module   @relation(fields: [moduleId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([roleId, moduleId])
}

model PaymentMethodMaster {
  id              Int                    @id @default(autoincrement())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  name            String
  branchId        Int?
  branch          Branch?                @relation(fields: [branchId], references: [id])
  purchases       PurchaseVoucher[]
  sales           SalesVoucher[]
  contraFrom      ContraVoucher[]        @relation("ContraFrom")
  contraTo        ContraVoucher[]        @relation("ContraTo")
  receiptVouchers ReceiptVoucher[]
  paymentVouchers PaymentVoucher[]
  purchaseReturns PurchaseReturnVoucher[]
  salesReturns    SalesReturnVoucher[]

  @@unique([name, branchId])
}

model PurchaseVoucher {
  id              Int                   @id @default(autoincrement())
  voucherNo       String                @unique
  supplierId      Int
  branchId        Int
  paymentMethodId Int
  createdById     Int
  date            DateTime
  subTotal        Float                 @default(0)
  taxAmount       Float                 @default(0)
  discountAmount  Float                 @default(0)
  totalAmount     Float
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  branch          Branch                @relation(fields: [branchId], references: [id])
  createdBy       User                  @relation(fields: [createdById], references: [id])
  paymentMethod   PaymentMethodMaster   @relation(fields: [paymentMethodId], references: [id])
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  items           PurchaseVoucherItem[]
}

model PurchaseVoucherItem {
  id             Int             @id @default(autoincrement())
  voucherId      Int
  productId      Int
  qty            Float
  rate           Float
  subTotal       Float           @default(0)
  taxRate        Float           @default(0)
  taxAmount      Float           @default(0)
  discountAmount Float           @default(0)
  amount         Float
  product        Product         @relation(fields: [productId], references: [id])
  voucher        PurchaseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
}

model SalesVoucher {
  id              Int                 @id @default(autoincrement())
  voucherNo       String              @unique
  customerId      Int
  branchId        Int
  paymentMethodId Int
  createdById     Int
  date            DateTime
  subTotal        Float               @default(0)
  taxAmount       Float               @default(0)
  discountAmount  Float               @default(0)
  totalAmount     Float
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  branch          Branch              @relation(fields: [branchId], references: [id])
  createdBy       User                @relation(fields: [createdById], references: [id])
  customer        Customer            @relation(fields: [customerId], references: [id])
  paymentMethod   PaymentMethodMaster @relation(fields: [paymentMethodId], references: [id])
  items           SalesVoucherItem[]
}

model SalesVoucherItem {
  id             Int          @id @default(autoincrement())
  voucherId      Int
  productId      Int
  qty            Float
  rate           Float
  subTotal       Float        @default(0)
  taxRate        Float        @default(0)
  taxAmount      Float        @default(0)
  discountAmount Float        @default(0)
  amount         Float
  product        Product      @relation(fields: [productId], references: [id])
  voucher        SalesVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
}

model StockDataVoucher {
  id          Int             @id @default(autoincrement())
  voucherNo   String          @unique
  warehouseId Int
  createdById Int
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  narration   String?
  productId   Int
  qty         Float
  branchId    Int?
  createdBy   User            @relation(fields: [createdById], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
  warehouse   WarehouseMaster @relation(fields: [warehouseId], references: [id])
  branch      Branch?         @relation(fields: [branchId], references: [id])
}

model StockTransferVoucher {
  id                 Int             @id @default(autoincrement())
  voucherNo          String          @unique
  fromWarehouseId    Int
  toWarehouseId      Int
  fromWarehouseName  String?
  toWarehouseName    String?
  createdById        Int
  date               DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  narration          String?
  productId          Int
  qty                Float
  branchId           Int?
  createdBy          User            @relation(fields: [createdById], references: [id])
  fromWarehouse      WarehouseMaster @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  product            Product         @relation(fields: [productId], references: [id])
  toWarehouse        WarehouseMaster @relation("TransferTo", fields: [toWarehouseId], references: [id])
  branch             Branch?         @relation(fields: [branchId], references: [id])
}

// ─── Contra Voucher ───────────────────────────────────────────────────────────
// Cash-to-bank or bank-to-bank internal fund transfer, no line items.

model ContraVoucher {
  id                  Int                 @id @default(autoincrement())
  voucherNo           String              @unique
  fromPaymentMethodId Int
  toPaymentMethodId   Int
  amount              Float
  narration           String?
  date                DateTime
  createdById         Int
  branchId            Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdBy           User                @relation(fields: [createdById], references: [id])
  fromPaymentMethod   PaymentMethodMaster @relation("ContraFrom", fields: [fromPaymentMethodId], references: [id])
  toPaymentMethod     PaymentMethodMaster @relation("ContraTo", fields: [toPaymentMethodId], references: [id])
  branch              Branch?             @relation(fields: [branchId], references: [id])
}

// ─── Receipt Voucher ─────────────────────────────────────────────────────────
// Money received from a customer.

model ReceiptVoucher {
  id              Int                 @id @default(autoincrement())
  voucherNo       String              @unique
  customerId      Int
  paymentMethodId Int
  amount          Float
  narration       String?
  date            DateTime
  createdById     Int
  branchId        Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy       User                @relation(fields: [createdById], references: [id])
  customer        Customer            @relation(fields: [customerId], references: [id])
  paymentMethod   PaymentMethodMaster @relation(fields: [paymentMethodId], references: [id])
  branch          Branch?             @relation(fields: [branchId], references: [id])
}

// ─── Payment Voucher ─────────────────────────────────────────────────────────
// Money paid to a supplier.

model PaymentVoucher {
  id              Int                 @id @default(autoincrement())
  voucherNo       String              @unique
  supplierId      Int
  paymentMethodId Int
  amount          Float
  narration       String?
  date            DateTime
  createdById     Int
  branchId        Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy       User                @relation(fields: [createdById], references: [id])
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  paymentMethod   PaymentMethodMaster @relation(fields: [paymentMethodId], references: [id])
  branch          Branch?             @relation(fields: [branchId], references: [id])
}

// ─── Purchase Return Voucher ──────────────────────────────────────────────────
// Returning goods back to supplier. Same structure as PurchaseVoucher.

model PurchaseReturnVoucher {
  id              Int                        @id @default(autoincrement())
  voucherNo       String                     @unique
  supplierId      Int
  branchId        Int
  paymentMethodId Int
  createdById     Int
  date            DateTime
  subTotal        Float                      @default(0)
  taxAmount       Float                      @default(0)
  discountAmount  Float                      @default(0)
  totalAmount     Float
  narration       String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  branch          Branch                     @relation(fields: [branchId], references: [id])
  createdBy       User                       @relation(fields: [createdById], references: [id])
  paymentMethod   PaymentMethodMaster        @relation(fields: [paymentMethodId], references: [id])
  supplier        Supplier                   @relation(fields: [supplierId], references: [id])
  items           PurchaseReturnVoucherItem[]
}

model PurchaseReturnVoucherItem {
  id             Int                   @id @default(autoincrement())
  voucherId      Int
  productId      Int
  qty            Float
  rate           Float
  subTotal       Float                 @default(0)
  taxRate        Float                 @default(0)
  taxAmount      Float                 @default(0)
  discountAmount Float                 @default(0)
  amount         Float
  product        Product               @relation(fields: [productId], references: [id])
  voucher        PurchaseReturnVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
}

// ─── Sales Return Voucher ─────────────────────────────────────────────────────
// Customer returning goods. Same structure as SalesVoucher.

model SalesReturnVoucher {
  id              Int                      @id @default(autoincrement())
  voucherNo       String                   @unique
  customerId      Int
  branchId        Int
  paymentMethodId Int
  createdById     Int
  date            DateTime
  subTotal        Float                    @default(0)
  taxAmount       Float                    @default(0)
  discountAmount  Float                    @default(0)
  totalAmount     Float
  narration       String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  branch          Branch                   @relation(fields: [branchId], references: [id])
  createdBy       User                     @relation(fields: [createdById], references: [id])
  customer        Customer                 @relation(fields: [customerId], references: [id])
  paymentMethod   PaymentMethodMaster      @relation(fields: [paymentMethodId], references: [id])
  items           SalesReturnVoucherItem[]
}

model SalesReturnVoucherItem {
  id             Int                @id @default(autoincrement())
  voucherId      Int
  productId      Int
  qty            Float
  rate           Float
  subTotal       Float              @default(0)
  taxRate        Float              @default(0)
  taxAmount      Float              @default(0)
  discountAmount Float              @default(0)
  amount         Float
  product        Product            @relation(fields: [productId], references: [id])
  voucher        SalesReturnVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
}
